# Service account that the Google Sheet is shared with (Editor access)
GOOGLE_SERVICE_ACCOUNT_EMAIL=portfolio-bot@your-project.iam.gserviceaccount.com

# Private key from the service account JSON file.
# Paste the whole value including BEGIN/END lines. Newlines may be literal \n — the code handles both.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# The ID from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
SHEET_ID=1AbC...

# Optional but recommended: shared key required for edits (scores, status, add/remove).
# Leave unset for open editing (only safe if the URL itself is access-restricted).
EDIT_KEY=pick-something-the-team-knows
